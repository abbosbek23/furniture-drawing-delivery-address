<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_sales_information" model="ir.ui.view">
        <field name="name">mrp.production.form.sales.information</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="before">
                <group name="sales_information" string="Sales Information"
                       groups="mrp.group_mrp_user">
                    <field name="sale_line_id" string="Sales Order Line"
                           groups="sales_team.group_sale_salesman"
                           domain="[('company_id', '=', company_id), ('product_id', '=', product_id), ('state', '=', 'sale'), ('display_type', '=', False)]"
                           options="{'no_create': True, 'no_open': True}"
                           readonly="state != 'draft'"/>
                    <field name="sale_order_id" groups="sales_team.group_sale_salesman"
                           options="{'no_open': True}"/>
                    <field name="production_address"/>
                    <field name="attachment_name" invisible="1"/>
                    <field name="order_attachment" widget="binary" filename="attachment_name"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
